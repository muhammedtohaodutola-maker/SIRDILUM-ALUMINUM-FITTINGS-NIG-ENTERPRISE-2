# ==============================================================================
# CLERK AUTHENTICATION CONFIGURATION
# Sign up at: https://clerk.com
# ==============================================================================

# Public Publishable Key (From Clerk Dashboard > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret Key for backend validation (From Clerk Dashboard > API Keys)
CLERK_SECRET_KEY=sk_test_...

# Authentication Routing Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Optional: Clerk Webhook Signing Secret (For syncing users to Supabase)
# Found under Clerk Dashboard > Webhooks > Add Endpoint
CLERK_WEBHOOK_SECRET=whsec_...
