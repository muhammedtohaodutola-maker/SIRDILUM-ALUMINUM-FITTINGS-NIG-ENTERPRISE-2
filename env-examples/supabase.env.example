# ==============================================================================
# SUPABASE DATABASE & STORAGE CONFIGURATION
# Sign up at: https://supabase.com
# ==============================================================================

# Project URL (From Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous Key (From Project Settings > API > Project API Keys > anon/public)
# Safe to expose in the browser; protected by Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Secret Key (From Project Settings > API > Project API Keys > service_role)
# NEVER expose to client-side. Used for server-side admin tasks and file storage
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage Buckets
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_DRAWINGS=architectural-drawings
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_PHOTOS=fabrication-progress
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_INVOICES=invoices-and-boqs

